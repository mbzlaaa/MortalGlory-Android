      TermType: 0
      Languages:
      - 来路不明的药水
      - Tuntematon Kulaus
      - 来路不明的药水
      - Неизвестное зелье
      - 手製のポーション
      - Une potion non identifiée
      - Ein nicht identifizierter Trank
      - 미확인 물약
      - Una poción no identificada
      - Una Pozione Ignota
      - Uma Poção Não Identificada
      - Niezidentyfikowana mikstura
      Flags: 000000000000000000000000
      Languages_Touch: []
